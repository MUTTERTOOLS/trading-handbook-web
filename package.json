{
  "name": "trading-handbook",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "content:build": "tsx tools/content/build.ts",
    "content:check": "tsx tools/content/check.ts",
    "typecheck:tools": "tsc -p tools/tsconfig.json --noEmit",
    "dev": "pnpm --filter @trading-handbook/web dev",
    "build": "pnpm --filter @trading-handbook/web build",
    "check": "pnpm content:check && pnpm typecheck:tools && pnpm --filter @trading-handbook/web check",
    "preview": "pnpm --filter @trading-handbook/web preview"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "markdown-it": "^14.1.0",
    "picocolors": "^1.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vue": "^3.5.13",
    "yaml": "^2.8.0",
    "zod": "^3.25.76"
  }
}
